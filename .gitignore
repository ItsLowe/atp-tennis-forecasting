# Private source data and match-level derivatives
/data/raw/
/data/processed/
*.xls
*.xlsx
*.csv
*.tsv

# Generated tables, figures, logs and sensitivity outputs stay private by default.
# Only reviewed summary material belongs in selected_results; currently a note only.
/outputs/*
!/outputs/selected_results/
/outputs/selected_results/*
!/outputs/selected_results/README.md

# Checkpoints, fitted objects and R session artifacts
rolling_checkpoints*/
*.rds
*.RDS
*.RData
*.rda
*.Rhistory
.Ruserdata
.Rproj.user/
Rplots.pdf

# Original reports, input archives and local staging folders
*.pdf
*.zip
/sources/
/reference/
/R_original/
/private/
/staging/

# Local credentials, configuration and machine metadata
.Renviron
.Renviron.*
.Rprofile
.env
.env.*
*.pem
*.key
.DS_Store
Thumbs.db
*.log
*~

# Phase 2: individually reviewed dissertation-reported aggregates only.
!/outputs/selected_results/reported_aggregates/
/outputs/selected_results/reported_aggregates/*
!/outputs/selected_results/reported_aggregates/figure_4_1_gap_reduction_reported.csv
!/outputs/selected_results/reported_aggregates/figure_4_2_disagreement_by_uncertainty_reported.csv
